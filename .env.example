# Copy to .env and fill in. Never commit real values. Used by the CLI (export them in
# your shell) and by docker compose (env_file).
GEMINI_API_KEY=
# Pin a model id. Aliases such as gemini-flash-latest follow the busiest model and can return 503.
GEMINI_MODEL=gemini-3.5-flash-lite

# Service (doc-extract serve, or docker compose up)
# API keys as name:key pairs, comma separated. Each key at least 16 characters, for
# example from: python -c "import secrets; print(secrets.token_urlsafe(32))"
DOC_EXTRACT_API_KEYS=
# DOC_EXTRACT_ALLOW_ANONYMOUS=1     # local use only: no key needed
# DOC_EXTRACT_PROVIDER=gemini       # or ollama, to keep documents on this machine
# DOC_EXTRACT_PRIMARY=vision
# DOC_EXTRACT_SECONDARY=text        # or none: halves cost, but nothing is auto-approved
# DOC_EXTRACT_REPAIR=1
# DOC_EXTRACT_VENDORS=data/vendors.json
# DOC_EXTRACT_CALIBRATION=eval/calibration.json
# DOC_EXTRACT_WORKERS=1
# DOC_EXTRACT_MAX_UPLOAD_MB=10
# DOC_EXTRACT_MAX_PAGES=5
